diff -Naur binutils-2.28-original/bfd/config.bfd binutils-2.28/bfd/config.bfd
--- binutils-2.28-original/bfd/config.bfd	2017-03-02 10:23:53.000000000 +0200
+++ binutils-2.28/bfd/config.bfd	2025-12-17 20:48:43.317678582 +0200
@@ -413,6 +413,10 @@
     targ_underscore=no
     targ_cflags="-DARM_WINCE -DARM_COFF_BUGFIX"
     ;;

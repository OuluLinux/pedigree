diff -Naur binutils-2.28-original/configure.ac binutils-2.28/configure.ac
--- binutils-2.28-original/configure.ac	2017-03-02 10:59:40.000000000 +0200
+++ binutils-2.28/configure.ac	2025-12-17 20:48:49.401148489 +0200
@@ -1828,7 +1828,7 @@
   # warn during gcc/ subconfigure; unless you're bootstrapping with
   # -flto it won't be needed until after installation anyway.
     case $target in
-      *-cygwin* | *-mingw* | *-apple-darwin* | *djgpp*) ;;
+      *-cygwin* | *-mingw* | *-apple-darwin* | *djgpp* | *pedigree*) ;;
       *) if test x"$enable_lto" = x"yes"; then
 	AC_MSG_ERROR([LTO support is not enabled for this target.])
         fi

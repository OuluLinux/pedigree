+    targ_selvecs=arm_elf32_be_vec
+    ;;
   arm-*-pe*)
     targ_defvec=arm_pe_le_vec
     targ_selvecs="arm_pe_le_vec arm_pe_be_vec arm_pei_le_vec arm_pei_be_vec"
@@ -878,6 +882,13 @@
